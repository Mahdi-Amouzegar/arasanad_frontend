# ═══════════════════════════════════════════════════════════════════════════
# متغیرهای محیطی فرانتاند
#
# ⚠️ فقط متغیرهایی که با NEXT_PUBLIC_ شروع میشوند در باندل مرورگر قرار میگیرند.
#    هرگز مقدار حساس در اینها نگذارید.
# ═══════════════════════════════════════════════════════════════════════════

# آدرس پایهی API (بدون اسلش انتهایی) — پوشش اختیاری.
# مقدار پیشفرض و مرجع در src/lib/config.ts تعریف شده است:
#   DEFAULT_API_BASE_URL = 'https://api.arasanad.ir/api/v1'
# اگر این خط خالی بماند یا فایل وجود نداشته باشد، همان مقدار استفاده میشود.
NEXT_PUBLIC_API_BASE_URL=https://api.arasanad.ir/api/v1

# ⚠️ در workflow استقرار عمداً هیچ متغیری تزریق نمیشود؛ بیلد همیشه مقدار
#    src/lib/config.ts را میگیرد. این فایل فقط برای توسعهی محلی است.
#    اگر Repository Variable قدیمی (workers.dev) در تنظیمات مخزن تعریف شده،
#    اکنون بیکار است، ولی بهتر است حذف شود تا ابهامی باقی نماند.
